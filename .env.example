# 复制本文件为 .env 并填入实际值
# cp .env.example .env

# NoneBot2 驱动
DRIVER=~fastapi
HOST=0.0.0.0

# OneBot v11 (NapCat) 配置
ONEBOT_PORT=28269
# 与 NapCat 的 OneBot 配置中 access_token 保持一致
ONEBOT_ACCESS_TOKEN=your_onebot_access_token

# WebUI 访问令牌（浏览器访问 /?token=xxx）
webui_token=your_webui_token

# 群白名单：只审核列表内的群，多个群号用英文逗号分隔；留空 = 审核所有群
GROUP_WHITELIST=

# HuggingFace 镜像（国内下载模型用，取消注释即可）
#HF_ENDPOINT=https://hf-mirror.com
